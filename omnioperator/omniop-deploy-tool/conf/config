#!/usr/bin/env bash
# omnioperator期望的spark版本号，当前支持的spark版本有：3.1.1   3.3.1   3.4.3   3.5.2
expect_spark_version=3.3.1
# omnioperator版本号
omnioperator_version=1.9.0
# 部署目录
target_path=/opt/omni-operator
# 是否安装sve版本的omnioperator，默认为false(小写字母)
sve_flag=false
# spark的conf目录
spark_conf_path=/usr/local/spark/conf
# 执行完脚本后是否进行功能验证
omni_check=true