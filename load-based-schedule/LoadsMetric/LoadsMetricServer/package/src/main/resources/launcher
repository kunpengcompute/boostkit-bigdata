function main()
{
  local cur_dir=$(cd $(dirname ${0});pwd)
  local parent_dir=$(dirname ${cur_dir})
  if [[ -n $(readlink "${parent_dir}"/deploy/control_resource.sh) ]] ; then
    echo "The control_resource.sh has soft link risks"
    exit 1
  fi
  if [[ -n $(readlink "${cur_dir}"/launcher.py) ]] ; then
    echo "The launcher.py has soft link risks"
    exit 1
  fi

  local option=${1}
  case ${option} in
    "start")
      python3 "${cur_dir}"/launcher.py $@
      sh "${parent_dir}"/deploy/control_resource.sh
      sh "${parent_dir}"/deploy/log.sh "Start LoadsMetric"
      ;;
    "stop")
      python3 "${cur_dir}"/launcher.py $@
      sh "${parent_dir}"/deploy/log.sh "Stop LoadsMetric"
      ;;
    "kill")
      python3 "${cur_dir}"/launcher.py $@
      sh "${parent_dir}"/deploy/log.sh "Kill LoadsMetric"
      ;;
    "restart")
      python3 "${cur_dir}"/launcher.py $@
      sh "${parent_dir}"/deploy/control_resource.sh
      sh "${parent_dir}"/deploy/log.sh "Restart LoadsMetric"
      ;;
    "status")
      python3 "${cur_dir}"/launcher.py $@
      ;;
    *)
      echo "USAGE: ${0}  start, stop, kill, restart, status"
      exit 1
  esac
}

main $@