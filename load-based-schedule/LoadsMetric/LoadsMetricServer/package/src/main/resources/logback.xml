<configuration>
    <!--LOG FILE PATH, DO NOT USE RELATIVE PATHS IN LOGBACK CONFIGURATION-->
    <property name="LOG_HOME" value="log" />

    <!-- LOG DATA AS DAY AND SIZE-->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/loadsmetric.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!--LOG FILE NAME-->
            <FileNamePattern>${LOG_HOME}/loadsmetric.%d{yyyy-MM-dd}.%i.log.gz</FileNamePattern>
            <!--LOG FILE RETENTION DAYS -->
            <MaxHistory>30</MaxHistory>
            <!-- LOG FILE MAX SIZE -->
            <MaxFileSize>2000MB</MaxFileSize>
            <!-- LOG FILE TOTAL SIZE CAP -->
            <TotalSizeCap>20GB</TotalSizeCap>
        </rollingPolicy>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <!-- LOG OUTPUT FORMAT %d: date, %thread: thread name, %-5level: level 5 length of package left, %msg: log message, %n: line break -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- LOG LEVEL -->
    <root level="INFO">
        <appender-ref ref="FILE" />
    </root>
</configuration>